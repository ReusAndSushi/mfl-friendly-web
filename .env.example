# --- Redis (auto-filled by Vercel's Marketplace Redis/Upstash integration).
# Depending on when you add it, the dashboard may populate either the
# UPSTASH_REDIS_REST_* or KV_REST_API_* names - this app accepts either.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Your club ---
MFL_CLUB_ID=602

# --- Your MFL session, copied from DevTools yourself (see README) ---
# Network tab -> click "Play" on any friendly -> the "matches/start" request
# -> Headers -> copy the exact "Authorization" header value (scheme included).
MFL_AUTH_HEADER=

# --- Matching / play behavior ---
MFL_FORMATION=4-3-3
MFL_TOLERANCE=3
MFL_DIVISION_RADIUS=1
MFL_MAX_PER_DAY=10

# --- Shared secret the GitHub Actions cron job must send to /api/play-next ---
CRON_SECRET=
